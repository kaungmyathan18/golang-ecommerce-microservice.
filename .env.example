# E-Commerce Microservices Environment

# JWT (shared by auth-service and api-gateway)
JWT_SECRET=dev-secret-change-me

# Gateway
PRODUCT_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_URL=http://localhost:8082
INVENTORY_SERVICE_URL=http://localhost:8084
PAYMENT_SERVICE_URL=http://localhost:8085
AUTH_SERVICE_URL=http://localhost:8086
RATE_LIMIT_RPM=60
REDIS_ADDR=localhost:6379

# Auth Service
# SERVER_PORT=8086
# JWT_TTL_HOURS=24
# DB_DSN=file:./data/auth.db?_foreign_keys=on

# Product Service
SERVER_PORT=8081
GRPC_PORT=9091
MONGO_URI=mongodb://localhost:27017
MONGO_DB=product-service
INVENTORY_SERVICE_URL=http://localhost:8084

# Inventory Service
# SERVER_PORT=8084
# GRPC_PORT=9093
# MONGO_DB=inventory-service

# Payment Service
# SERVER_PORT=8085
# DB_DSN=file:./data/payments.db?_foreign_keys=on
# PAYMENT_STUB_DELAY_SEC=5

# Order Service
# SERVER_PORT=8082
DB_HOST=localhost
DB_PORT=5434
DB_USER=app
DB_PASSWORD=app
DB_NAME=order-service
DB_AUTO_MIGRATE=true
PRODUCT_GRPC_ADDR=localhost:9091
INVENTORY_GRPC_ADDR=localhost:9093
PAYMENT_SERVICE_URL=http://localhost:8085

# Notification Service
# SERVER_PORT=8083
DB_DSN=file:./data/notifications.db?_foreign_keys=on

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
